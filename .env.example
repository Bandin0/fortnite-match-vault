# Copy this file to ".env" and edit as needed. Everything here is optional.

# Port on the HOST to expose the web UI on (default 8090)
HOST_PORT=8090

# Require an "x-ingest-key" header on uploads. Leave blank for open uploads
# (fine on a trusted LAN; set it if the port is reachable by others).
FORTNITE_INGEST_KEY=

# Your in-game name. Used to disambiguate who "you" are in a replay when the
# recorder-owner flag is missing (common in modern replays).
FORTNITE_ME_NAME=